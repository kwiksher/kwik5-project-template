@echo off

cd {{dst}}
copy /Y {{newIndex}} App\{{book}}\components\{{page}}\
move App\{{book}}\components\{{page}}\timers\{{timer}}.lua App\{{book}}\components\{{page}}\timers\{{newName}}.lua
powershell -Command "(Get-Content App\{{book}}\components\{{page}}\timers\{{newName}}.lua) -replace '{{group}}', '{{newName}}' | Set-Content App\{{book}}\components\{{page}}\timers\{{newName}}.lua"
exit
