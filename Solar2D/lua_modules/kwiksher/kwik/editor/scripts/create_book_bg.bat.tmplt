@echo off

set dst=Solar2D
set book={{book}}
set pages=page1
set tmp=

mkdir %dst%\App\%book%
cd %dst%\App\%book%

for %%p in (%pages%) do (
  set page=%%p
  set tmp=!tmp!'%%p', 
  echo !page!
  
  mkdir assets\images\!page!
  mkdir commands\!page!
  mkdir components\!page!
  mkdir components\!page!\audios
  mkdir components\!page!\audios\long
  mkdir components\!page!\audios\short
  mkdir components\!page!\audios\sync
  mkdir components\!page!\groups
  mkdir components\!page!\layers
  mkdir components\!page!\page
  mkdir components\!page!\timers
  mkdir components\!page!\variables
  mkdir components\!page!\joints
  mkdir models\!page!
  
  copy ..\..\template\components\pageX\layer\bg.lua components\!page!\layers\bg.lua
  
  cd components\!page!
  echo local sceneName = ... > index.lua
  echo -- >> index.lua
  echo local scene = require('controller.scene').new(sceneName, { >> index.lua
  echo     components = { >> index.lua
  echo       layers = { { bg={} } }, >> index.lua
  echo       audios = { }, >> index.lua
  echo       groups = { }, >> index.lua
  echo       timers = { }, >> index.lua
  echo       variables = { }, >> index.lua
  echo       page = { } >> index.lua
  echo     }, >> index.lua
  echo     commands = { }, >> index.lua
  echo     onInit = function(scene) print("onInit") end >> index.lua
  echo }) >> index.lua
  echo -- >> index.lua
  echo return scene >> index.lua
  
  cd ..\..
)

echo !tmp!

cd %dst%\App\%book%
echo local scenes = { > index.lua
echo !tmp! >> index.lua
echo } >> index.lua
echo return scenes >> index.lua

cd %dst%\App\%book%\assets
echo local M = { > model.lua
echo   audios = {}, sprites = {}, videos = {} >> model.lua
echo } >> model.lua
echo return M >> model.lua

exit /b
